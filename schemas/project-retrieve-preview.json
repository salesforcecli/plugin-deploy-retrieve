{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/PreviewResult",
  "definitions": {
    "PreviewResult": {
      "type": "object",
      "properties": {
        "ignored": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreviewFile"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreviewFile"
          }
        },
        "toDeploy": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreviewFile"
          }
        },
        "toDelete": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreviewFile"
          }
        },
        "toRetrieve": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreviewFile"
          }
        },
        "transportPlan": {
          "$ref": "#/definitions/TransportPlan"
        }
      },
      "required": ["ignored", "conflicts", "toDeploy", "toDelete", "toRetrieve"],
      "additionalProperties": false
    },
    "PreviewFile": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "conflict": {
          "type": "boolean"
        },
        "ignored": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "projectRelativePath": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "enum": ["deploy", "retrieve", "deletePost", "deletePre"]
        }
      },
      "required": ["fullName", "type", "conflict", "ignored"],
      "additionalProperties": false
    },
    "TransportPlan": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TransportPlanPhase"
          }
        }
      },
      "required": ["phases"],
      "additionalProperties": false
    },
    "TransportPlanPhase": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["before-metadata", "metadata-api", "after-metadata"]
        },
        "label": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fullName": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": ["fullName", "type"],
            "additionalProperties": false
          }
        }
      },
      "required": ["phase", "label", "endpoint", "components"],
      "additionalProperties": false
    }
  }
}
